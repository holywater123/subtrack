# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings -> Data API (URL) and API Keys (anon / publishable key).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for the AI spending insight on the Overview tab. Get a key at
# https://openrouter.ai/keys - without it, the insight card just shows a
# placeholder message instead of calling the API.
OPENROUTER_API_KEY=

# Optional - defaults to anthropic/claude-3.5-haiku if unset.
OPENROUTER_MODEL=

# Optional - vision-capable model used to read receipt/screenshot uploads
# on the Expenses tab. Defaults to openai/gpt-4o-mini if unset. Must be a
# vision-capable model (the default OPENROUTER_MODEL above is text-only).
OPENROUTER_VISION_MODEL=
